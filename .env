PORT=8081

# ─── MYSQL DATABASE ───────────────────────────────────────────
# IMPORTANT: Change DB_PASSWORD to your actual MySQL root password!
# If your MySQL root has no password, leave it empty (DB_PASSWORD=)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=holdkart

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=holdkart_customer_jwt_secret_change_this_in_production
JWT_REFRESH_SECRET=holdkart_customer_refresh_secret_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── EMAIL (for forgot password) ──────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ─── URLS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8081
SELLER_BACKEND_URL=http://localhost:8080

# ─── CASHFREE (Test / Sandbox) ────────────────────────────────
# Get your test keys from: https://merchant.cashfree.com/merchants/login
# Dashboard → Developers → API Keys → Test Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=